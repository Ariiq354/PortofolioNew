---
import Phone from "../assets/Phone.astro";
import Mail from "../assets/Mail.astro";
import House from "../assets/House.astro";
import Layout from "../layouts/Layout.astro";
import Button from "@/components/starwind/button";

const info = [
    {
        icon: Phone,
        title: "Phone",
        description: "+62 896 0583 4601",
    },
    {
        icon: Mail,
        title: "Email",
        description: "m.ariiq.abdillah@gmail.com",
    },
    {
        icon: House,
        title: "Address",
        description: "Cakung, Jakarta Timur, DKI Jakarta",
    },
];
---

<Layout pathname="/contact">
    <main class="py-12 xl:py-24">
        <div class="container mx-auto">
            <div class="flex flex-col gap-12 xl:flex-row">
                <!-- Form Section -->
                <div class="order-2 xl:order-0 xl:w-[54%]">
                    <form
                        class="flex flex-col gap-6 rounded-2xl border border-white/5 bg-neutral-900/60 p-8 xl:p-10 backdrop-blur-md"
                    >
                        <h2 class="text-4xl font-bold text-primary">
                            Let's Work Together
                        </h2>
                        <p class="text-white/60 text-sm leading-relaxed">
                            I'd love to hear from you! Whether you have a
                            question, a project in mind, or just want to say
                            hello, feel free to get in touch. I'll get back to
                            you as soon as possible.
                        </p>

                        <div class="grid grid-cols-1 gap-6">
                            <input
                                name="name"
                                placeholder="Name"
                                class="bg-input/60 border border-border rounded-lg px-4 py-3 text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all duration-300 outline-none text-sm"
                            />

                            <input
                                name="email"
                                type="email"
                                placeholder="Email Address"
                                class="bg-input/60 border border-border rounded-lg px-4 py-3 text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all duration-300 outline-none text-sm"
                            />
                            <textarea
                                name="message"
                                rows="4"
                                placeholder="Message"
                                class="bg-input/60 border border-border rounded-lg px-4 py-3 text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all duration-300 outline-none text-sm"
                            ></textarea>
                        </div>

                        <Button
                            type="submit"
                            variant="primary"
                            class="max-w-40 rounded-full text-black font-semibold hover:scale-105 transition-all duration-300"
                        >
                            Send Message
                        </Button>
                    </form>
                </div>

                <!-- Contact Info Section -->
                <div
                    class="order-1 mb-8 flex flex-1 items-center xl:order-0 xl:mb-0 xl:justify-end"
                >
                    <ul class="flex flex-col gap-8 w-full xl:max-w-md">
                        {
                            info.map((item) => (
                                <li class="flex items-center gap-6 p-5 rounded-xl border border-white/5 bg-neutral-900/40 backdrop-blur-md hover:border-primary/40 hover:bg-neutral-900/60 hover:shadow-[0_0_20px_-3px_rgba(134,239,172,0.08)] transition-all duration-300 group">
                                    <div class="flex aspect-square w-14 items-center justify-center rounded-lg bg-neutral-950 border border-white/10 text-primary xl:w-18 group-hover:border-primary/50 transition-colors duration-300">
                                        <div class="text-2xl group-hover:scale-110 transition-transform duration-300">
                                            <item.icon class="text-primary" />
                                        </div>
                                    </div>
                                    <div class="flex-1">
                                        <h3 class="text-white/50 text-sm font-medium">
                                            {item.title}
                                        </h3>
                                        <p class="text-lg font-semibold text-white/95 mt-0.5">
                                            {item.description}
                                        </p>
                                    </div>
                                </li>
                            ))
                        }
                    </ul>
                </div>
            </div>
        </div>
    </main>
</Layout>
