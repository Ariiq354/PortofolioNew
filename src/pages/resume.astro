---
import {
    Tabs,
    TabsContent,
    TabsList,
    TabsTrigger,
} from "@/components/starwind/tabs";
import Layout from "@/layouts/Layout.astro";
import Nest from "../assets/brand/Nest.astro";
import Next from "../assets/brand/Next.astro";
import Nuxt from "../assets/brand/Nuxt.astro";
import Python from "../assets/brand/Python.astro";
import React from "../assets/brand/React.astro";
import Svelte from "../assets/brand/Svelte.astro";
import Tailwind from "../assets/brand/Tailwind.astro";
import Vue from "../assets/brand/Vue.astro";

const experience = [
    {
        time: "April 2025 - Now",
        title: "Fullstack Developer",
        company: "Sinar Sakti Internasional",
    },
    {
        time: "Feb 2024 - May 2024",
        title: "Fullstack Developer",
        company: "CV. Berjuang Bersama Barokah",
    },
    {
        time: "Oct 2023 - Jan 2024",
        title: "Fullstack Developer",
        company: "PT. Tirtaloka Nusantara",
    },
    {
        time: "Jan 2023 - Mar 2023",
        title: "PHP Developer",
        company: "CV. Berjuang Bersama Barokah",
    },
];

const education = [
    {
        time: "2021 - 2024",
        title: "Information Technology",
        school: "President University",
    },
    { time: "2019 - 2021", title: "Science", school: "SMAN 2 Cibinong" },
];

const skills = [
    {
        name: "Svelte",
        svg: Svelte,
    },
    {
        name: "Vue",
        svg: Vue,
    },
    {
        name: "React",
        svg: React,
    },
    {
        name: "Tailwind",
        svg: Tailwind,
    },
    {
        name: "NextJS",
        svg: Next,
    },
    {
        name: "Nuxt",
        svg: Nuxt,
    },
    {
        name: "Nest",
        svg: Nest,
    },
    {
        name: "Python",
        svg: Python,
    },
];

const info = [
    { name: "Name", value: "Muhammad Ariiq A. Abdillah" },
    { name: "Phone", value: "+62 896 0583 4601" },
    { name: "Experience", value: "2 years" },
    { name: "Nationality", value: "Indonesia" },
    { name: "Email", value: "m.ariiq.abdillah@gmail.com" },
    { name: "Language", value: "Indonesia, English" },
];
---

<Layout pathname="/resume">
    <main class="flex min-h-[80vh] justify-center py-12 xl:py-24">
        <div class="container mx-auto">
            <Tabs
                defaultValue="experience"
                class="flex flex-col xl:flex-row gap-8 xl:gap-15 h-auto xl:items-start"
            >
                <TabsList
                    class="flex flex-col w-full xl:max-w-95 bg-transparent mx-auto gap-6 shrink-0"
                >
                    <div
                        class="flex max-w-95 flex-col gap-4 text-center xl:text-left mb-4"
                    >
                        <h1
                            class="text-5xl text-white font-bold tracking-tight"
                        >
                            Why Hire Me?
                        </h1>
                        <p
                            class="mx-auto text-white/60 xl:mx-0 text-sm leading-relaxed"
                        >
                            I have a proficiency in technologies and a passion
                            to learn new things in every project. By hiring me,
                            you will gain a committed partner focused on
                            delivering high-quality results.
                        </p>
                    </div>
                    <TabsTrigger
                        value="experience"
                        class="w-full grow-0 rounded-md data-[state=active]:bg-primary data-[state=active]:text-black text-white bg-neutral-900/50 border border-white/5 hover:border-primary/30 transition-all duration-300 py-3 cursor-pointer"
                    >
                        Experience
                    </TabsTrigger>
                    <TabsTrigger
                        value="education"
                        class="w-full grow-0 rounded-md data-[state=active]:bg-primary data-[state=active]:text-black text-white bg-neutral-900/50 border border-white/5 hover:border-primary/30 transition-all duration-300 py-3 cursor-pointer"
                    >
                        Education
                    </TabsTrigger>
                    <TabsTrigger
                        value="skills"
                        class="w-full grow-0 rounded-md data-[state=active]:bg-primary data-[state=active]:text-black text-white bg-neutral-900/50 border border-white/5 hover:border-primary/30 transition-all duration-300 py-3 cursor-pointer"
                    >
                        Skills
                    </TabsTrigger>
                    <TabsTrigger
                        value="about"
                        class="w-full grow-0 rounded-md data-[state=active]:bg-primary data-[state=active]:text-black text-white bg-neutral-900/50 border border-white/5 hover:border-primary/30 transition-all duration-300 py-3 cursor-pointer"
                    >
                        About Me
                    </TabsTrigger>
                </TabsList>
                <TabsContent value="experience" class="w-full flex-1">
                    <div class="flex flex-col gap-7.5 text-center xl:text-left">
                        <h2 class="text-4xl font-bold">My Experience</h2>
                        <p class="mx-auto max-w-150 text-white/60 xl:mx-0">
                            Showcasing my experience, this section outlines my
                            roles in the company, demonstrating my experience in
                            web development.
                        </p>
                        <div>
                            <ul class="grid grid-cols-1 gap-7.5 lg:grid-cols-2">
                                {
                                    experience.map((item) => (
                                        <li class="flex h-46 flex-col items-center justify-center gap-2 rounded-xl border border-white/5 bg-neutral-900/40 px-10 py-6 lg:items-start backdrop-blur-md transition-all duration-300 hover:border-primary/50 hover:bg-neutral-900/60 hover:shadow-[0_0_20px_-3px_rgba(134,239,172,0.1)] hover:-translate-y-1">
                                            <span class="text-primary text-sm mono-accent">
                                                {item.time}
                                            </span>
                                            <h3 class="min-h-12.5 max-w-65 text-center text-xl lg:text-left font-semibold text-white/90">
                                                {item.title}
                                            </h3>
                                            <div class="flex items-center gap-3">
                                                <span class="aspect-square w-1.5 rounded-full bg-primary" />
                                                <p class="text-white/60 text-sm">
                                                    {item.company}
                                                </p>
                                            </div>
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>
                    </div>
                </TabsContent>
                <TabsContent value="education" class="w-full flex-1">
                    <div class="flex flex-col gap-7.5 text-center xl:text-left">
                        <h2 class="text-4xl font-bold">My Education</h2>
                        <p class="mx-auto max-w-150 text-white/60 xl:mx-0">
                            Detailing my academic background, this section
                            highlights the degrees I've earned.
                        </p>
                        <div>
                            <ul class="grid grid-cols-1 gap-7.5 lg:grid-cols-2">
                                {
                                    education.map((item) => (
                                        <li class="flex h-46 flex-col items-center justify-center gap-2 rounded-xl border border-white/5 bg-neutral-900/40 px-10 py-6 lg:items-start backdrop-blur-md transition-all duration-300 hover:border-primary/50 hover:bg-neutral-900/60 hover:shadow-[0_0_20px_-3px_rgba(134,239,172,0.1)] hover:-translate-y-1">
                                            <span class="text-primary text-sm mono-accent">
                                                {item.time}
                                            </span>
                                            <h3 class="min-h-12.5 max-w-65 text-center text-xl lg:text-left font-semibold text-white/90">
                                                {item.title}
                                            </h3>
                                            <div class="flex items-center gap-3">
                                                <span class="aspect-square w-1.5 rounded-full bg-primary" />
                                                <p class="text-white/60 text-sm">
                                                    {item.school}
                                                </p>
                                            </div>
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>
                    </div>
                </TabsContent>
                <TabsContent value="skills" class="w-full flex-1">
                    <div class="flex flex-col gap-7.5 text-center xl:text-left">
                        <h2 class="text-4xl font-bold">Skills</h2>
                        <p class="mx-auto max-w-150 text-white/60 xl:mx-0">
                            A list of my technical proficiencies, showcasing the
                            tools and technologies I use to deliver a website.
                        </p>
                        <div>
                            <ul
                                class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6"
                            >
                                {
                                    skills.map((item) => (
                                        <li class="group flex flex-col items-center justify-center gap-4 rounded-xl border border-white/5 bg-neutral-900/40 p-6 backdrop-blur-md transition-all duration-300 hover:border-primary/50 hover:bg-neutral-900/60 hover:shadow-[0_0_25px_-5px_rgba(134,239,172,0.15)] hover:-translate-y-1">
                                            <div class="text-white/60 transition-all duration-300 group-hover:scale-110 group-hover:text-primary size-12 flex items-center justify-center">
                                                <item.svg class="size-10" />
                                            </div>
                                            <span class="text-sm font-medium tracking-wide text-white/70 transition-all duration-300 group-hover:text-white mono-accent">
                                                {item.name}
                                            </span>
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>
                    </div>
                </TabsContent>
                <TabsContent value="about" class="w-full flex-1">
                    <div class="flex flex-col gap-7.5 text-center xl:text-left">
                        <h2 class="text-4xl font-bold">About Me</h2>
                        <p class="mx-auto max-w-150 text-white/60 xl:mx-0">
                            A brief introduction to who I am as a person,
                            including my contact details.
                        </p>
                        <div
                            class="bg-neutral-900/40 border border-white/5 rounded-xl p-8 backdrop-blur-md"
                        >
                            <ul class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                {
                                    info.map((item) => (
                                        <li class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4 pb-4 border-b border-white/5 last:border-0">
                                            <span class="text-white/50 text-sm min-w-30">
                                                {item.name}
                                            </span>
                                            <span class="text-lg font-medium text-white/90">
                                                {item.value}
                                            </span>
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>
                    </div>
                </TabsContent>
            </Tabs>
        </div>
    </main>
</Layout>
