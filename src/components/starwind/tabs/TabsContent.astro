---
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

interface Props extends Omit<HTMLAttributes<"div">, "id" | "role" | "tabindex" | "hidden"> {
	value: string;
}

const tabsContent = tv({ base: "mt-2 focus-visible:outline-2 focus-visible:outline-offset-2 data-[state=active]:animate-in data-[state=active]:fade-in-50 data-[state=active]:duration-300" });

const { value, class: className, ...rest } = Astro.props;
---

<div
	class={tabsContent({ class: className })}
	data-tabs-content
	data-value={value}
	data-state="inactive"
	role="tabpanel"
	tabindex="0"
	hidden
	{...rest}
>
	<slot />
</div>
