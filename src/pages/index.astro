---
import Button from "@/components/starwind/button";
import Download from "../assets/Download.astro";
import Github from "../assets/Github.astro";
import Linkedin from "../assets/Linkedin.astro";
import Layout from "../layouts/Layout.astro";
import { Tooltip, TooltipTrigger, TooltipContent } from "@/components/starwind/tooltip";
---

<Layout pathname="/">
    <main class="flex-1 flex items-center py-12 xl:py-24">
        <div class="container mx-auto h-full">
            <div
                class="flex flex-col items-center justify-between xl:flex-row gap-12 xl:pb-24 xl:pt-8"
            >
                <div
                    class="order-2 text-center xl:order-0 xl:text-left flex flex-col items-center xl:items-start"
                >
                    <span
                        class="text-xs uppercase tracking-[0.2em] text-primary bg-primary/10 border border-primary/20 rounded-full px-4 py-1.5 mono-accent mb-6 inline-block font-semibold"
                    >
                        Fullstack Developer
                    </span>
                    <h1
                        class="mb-6 text-[48px] font-bold leading-[1.1] xl:text-[80px] text-white"
                    >
                        Hello I'm <br />
                        <span
                            class="text-transparent bg-clip-text bg-linear-to-r from-primary via-green-400 to-emerald-400 drop-shadow-[0_2px_15px_rgba(134,239,172,0.15)]"
                            >Muhammad Ariiq</span
                        >
                    </h1>
                    <p
                        class="mb-9 max-w-125 text-white/70 text-sm xl:text-base leading-relaxed"
                    >
                        I'm a Fullstack Developer with a passion for web design.
                        I am proficient in various frontend frameworks and
                        modern web technologies.
                    </p>
                    <div class="flex flex-col items-center gap-8 xl:flex-row">
                        <a href="/CV.pdf" download="CV.pdf">
                            <Button
                                variant="outline"
                                class="flex items-center gap-2 rounded-full uppercase border-primary text-primary hover:bg-primary hover:text-black font-semibold tracking-wider text-xs transition-all duration-300 hover:scale-105"
                            >
                                Download CV
                                <Download size="20" />
                            </Button>
                        </a>
                        <div class="mb-8 xl:mb-0">
                            <div class="flex gap-6">
                                <Tooltip>
                                    <TooltipTrigger>
                                        <a
                                            href="https://github.com/Ariiq354"
                                            aria-label="github"
                                            class="flex items-center justify-center rounded-full border border-primary p-3 text-primary transition-all duration-300 hover:bg-primary hover:text-black hover:scale-110 hover:shadow-[0_0_15px_rgba(134,239,172,0.3)]"
                                        >
                                            <Github size={20} />
                                        </a>
                                    </TooltipTrigger>
                                    <TooltipContent side="top" align="center">
                                        GitHub Profile
                                    </TooltipContent>
                                </Tooltip>
                                <Tooltip>
                                    <TooltipTrigger>
                                        <a
                                            href="https://www.linkedin.com/in/muhammadariiq"
                                            target="_blank"
                                            aria-label="linkedin"
                                            class="flex items-center justify-center rounded-full border border-primary p-3 text-primary transition-all duration-300 hover:bg-primary hover:text-black hover:scale-110 hover:shadow-[0_0_15px_rgba(134,239,172,0.3)]"
                                        >
                                            <Linkedin size={20} />
                                        </a>
                                    </TooltipTrigger>
                                    <TooltipContent side="top" align="center">
                                        LinkedIn Profile
                                    </TooltipContent>
                                </Tooltip>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Photo -->
                <div class="order-1 mb-8 xl:order-0 xl:mb-0">
                    <div
                        class="relative flex h-full w-full items-center justify-center"
                    >
                        <!-- Aura Glow behind photo -->
                        <div
                            class="absolute aspect-square w-62.5 xl:w-105 rounded-full bg-primary/10 blur-3xl -z-10 animate-pulse"
                        >
                        </div>

                        <div
                            class="absolute flex aspect-square w-68.5 items-center justify-center overflow-hidden rounded-full xl:w-117.5 border border-white/10 shadow-[0_0_50px_-10px_rgba(134,239,172,0.2)]"
                        >
                            <img
                                src="/fotoProfil.webp"
                                alt="Profile"
                                width="963"
                                height="1280"
                                class="object-cover w-full h-full"
                            />
                        </div>
                        <svg
                            class="h-75 w-75 animate-[spin_30s_linear_infinite] xl:h-126.5 xl:w-126.5"
                            fill="transparent"
                            viewBox="0 0 506 506"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <circle
                                cx="253"
                                cy="253"
                                r="250"
                                class="stroke-primary/80"
                                stroke-width="4"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-dasharray="24 12 2 20"></circle>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </main>
</Layout>
